# --- App & Network ---
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Database (Multi-Role PostgreSQL RLS Isolation) ---
# Schema owner / migration URL (used ONLY by Prisma Migrate & seed)
DATABASE_MIGRATION_URL=postgresql://postgres:postgres@localhost:5432/autonex?schema=public

# Restricted app role (NOSUPERUSER NOBYPASSRLS) — PostgreSQL RLS enforced on every tenant query
DATABASE_URL=postgresql://autonex_app:autonex_app_pass@localhost:5432/autonex?schema=public

# Audited Super Admin / Auth bootstrap role (used ONLY by AdminModule & login lookup)
DATABASE_ADMIN_URL=postgresql://autonex_admin:autonex_admin_pass@localhost:5432/autonex?schema=public

# --- Auth & Security ---
JWT_ACCESS_SECRET=dev_only_replace_with_64_char_random_hex_access_secret_key_001
JWT_REFRESH_SECRET=dev_only_replace_with_64_char_random_hex_refresh_secret_key_002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
QR_SIGNING_SECRET=dev_only_replace_with_64_char_random_hex_qr_signing_secret_003
RATE_LIMIT_TTL_SEC=60
RATE_LIMIT_MAX_REQ=60

# --- Initial Super Admin Bootstrap (Seed / Init) ---
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_EMAIL=admin@autonex.in
SUPER_ADMIN_PHONE=+919999999999
SUPER_ADMIN_PASSWORD=ChangeMe123!
# Optional one-time token protecting POST /api/v1/auth/super-admin/setup when no Super Admin exists yet
SUPER_ADMIN_SETUP_TOKEN=

# --- Media Storage & CDN (S3-compatible or local fallback in dev) ---
S3_STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=autonex-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=http://localhost:4000/uploads
LOCAL_UPLOAD_DIR=./uploads

# --- Billing & Razorpay Payments (Phase 6) ---
# Leave keys empty in development to run deterministic local Razorpay mock checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev_only_razorpay_webhook_secret_change_in_prod
RAZORPAY_MOCK_MODE=true
PAYMENT_RECONCILE_STALE_MINUTES=2

# Redis / BullMQ (Milestone 1+)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
SKIP_REDIS_CONNECT=false
