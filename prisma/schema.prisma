  kitchenStationSnapshot KitchenStation  @default(MAIN_KITCHEN) @map("kitchen_station_snapshot")
  status                 OrderItemStatus @default(ACTIVE)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  billLines BillLine[]

  @@index([tenantId, orderId])
  @@map("order_items")
}

model OrderEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  eventType    String   @map("event_type") @db.VarChar(40)
  fromStatus   String?  @map("from_status") @db.VarChar(20)
  toStatus     String?  @map("to_status") @db.VarChar(20)
  actorType    String   @map("actor_type") @db.VarChar(20)
  actorId      String?  @map("actor_id") @db.Uuid
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
  @@map("order_events")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  topic         String       @db.VarChar(80)
  aggregateType String       @map("aggregate_type") @db.VarChar(40)
