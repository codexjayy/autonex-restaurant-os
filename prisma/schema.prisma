  joinCodeExpiresAt     DateTime?           @map("join_code_expires_at") @db.Timestamptz()
  openedByMembershipId  String?             @map("opened_by_membership_id") @db.Uuid
  settledByMembershipId String?             @map("settled_by_membership_id") @db.Uuid
  closedByMembershipId  String?             @map("closed_by_membership_id") @db.Uuid
  openedAt              DateTime            @default(now()) @map("opened_at") @db.Timestamptz()
  billRequestedAt       DateTime?           @map("bill_requested_at") @db.Timestamptz()
  settledAt             DateTime?           @map("settled_at") @db.Timestamptz()
  closedAt              DateTime?           @map("closed_at") @db.Timestamptz()

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet              Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
