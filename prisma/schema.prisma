model Bill {
  id                    String     @id @default(uuid()) @db.Uuid
  tenantId              String     @map("tenant_id") @db.Uuid
  outletId              String     @map("outlet_id") @db.Uuid
  sessionId             String     @map("session_id") @db.Uuid
  billNumber            String     @map("bill_number") @db.VarChar(40)
  status                BillStatus @default(OPEN)
  subtotalPaise         Int        @map("subtotal_paise")
  discountPaise         Int        @default(0) @map("discount_paise")
  discountReason        String?    @map("discount_reason") @db.VarChar(200)
  taxMode               TaxMode    @default(EXCLUSIVE) @map("tax_mode")
  gstRateBps            Int        @default(500) @map("gst_rate_bps")
  cgstPaise             Int        @map("cgst_paise")
  sgstPaise             Int        @map("sgst_paise")
  roundOffPaise         Int        @default(0) @map("round_off_paise")
  totalPaise            Int        @map("total_paise")
  paidPaise             Int        @default(0) @map("paid_paise")
  refundedPaise         Int        @default(0) @map("refunded_paise")
  gstinSnapshot         String?    @map("gstin_snapshot") @db.VarChar(20)
  outletNameSnapshot    String     @map("outlet_name_snapshot") @db.VarChar(120)
  outletAddressSnapshot String?    @map("outlet_address_snapshot") @db.VarChar(300)
  billSnapshotJson      Json       @default("{}") @map("bill_snapshot_json")
  voidReason            String?    @map("void_reason") @db.VarChar(200)
  voidedByMembershipId  String?    @map("voided_by_membership_id") @db.Uuid
  voidedAt              DateTime?  @map("voided_at") @db.Timestamptz()
  finalizedAt           DateTime   @default(now()) @map("finalized_at") @db.Timestamptz()
  paidAt                DateTime?  @map("paid_at") @db.Timestamptz()
  createdAt             DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet             Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  session            DiningSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  voidedByMembership Membership?         @relation("BillVoidedBy", fields: [voidedByMembershipId], references: [id], onDelete: SetNull)
  lines              BillLine[]
  paymentAttempts    PaymentAttempt[]
  allocations        PaymentAllocation[]
  refunds            Refund[]

  @@unique([tenantId, outletId, billNumber])
  @@index([tenantId, outletId, status, createdAt(sort: Desc)])
  @@index([tenantId, sessionId])
  @@map("bills")
}

model BillLine {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  billId          String       @map("bill_id") @db.Uuid
