}

// ============================================================================
// PHASE 7: SUPER ADMIN, SUBSCRIPTION PLANS & SUPPORT CASES
// ============================================================================

model Plan {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique @db.VarChar(40)
  name              String   @db.VarChar(80)
  description       String?  @db.VarChar(300)
  monthlyPricePaise Int      @map("monthly_price_paise")
  yearlyPricePaise  Int      @map("yearly_price_paise")
  maxOutlets        Int      @default(1) @map("max_outlets")
  maxTables         Int      @default(30) @map("max_tables")
  maxStaff          Int      @default(15) @map("max_staff")
  trialDays         Int      @default(14) @map("trial_days")
  graceDays         Int      @default(3) @map("grace_days")
  featuresJson      Json     @default("[]") @map("features_json")
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

