  openedByMembership  Membership?     @relation("SessionOpenedBy", fields: [openedByMembershipId], references: [id], onDelete: SetNull)
  settledByMembership Membership?     @relation("SessionSettledBy", fields: [settledByMembershipId], references: [id], onDelete: SetNull)
