  quantity        Int          @default(1)
  unitAmountPaise Int          @map("unit_amount_paise")
  lineAmountPaise Int          @map("line_amount_paise")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bill      Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([tenantId, billId])
  @@map("bill_lines")
}

model PaymentAttempt {
  id                      String          @id @default(uuid()) @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  outletId                String          @map("outlet_id") @db.Uuid
  billId                  String          @map("bill_id") @db.Uuid
  method                  PaymentMethod
  provider                PaymentProvider
  amountPaise             Int             @map("amount_paise")
  status                  PaymentStatus   @default(INITIATED)
  idempotencyKey          String          @map("idempotency_key") @db.VarChar(120)
  gatewayOrderId          String?         @map("gateway_order_id") @db.VarChar(100)
  gatewayPaymentId        String?         @unique @map("gateway_payment_id") @db.VarChar(100)
  qrPayloadUrl            String?         @map("qr_payload_url") @db.Text
  receiptRef              String?         @map("receipt_ref") @db.VarChar(120)
  confirmedByMembershipId String?         @map("confirmed_by_membership_id") @db.Uuid
  failureReason           String?         @map("failure_reason") @db.VarChar(250)
  reconcileAttempts       Int             @default(0) @map("reconcile_attempts")
  lastReconciledAt        DateTime?       @map("last_reconciled_at") @db.Timestamptz()
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz()
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet                Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  bill                  Bill                @relation(fields: [billId], references: [id], onDelete: Restrict)
  confirmedByMembership Membership?         @relation("PaymentConfirmedBy", fields: [confirmedByMembershipId], references: [id], onDelete: SetNull)
  allocations           PaymentAllocation[]
  refunds               Refund[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, billId, createdAt])
  @@index([status, createdAt])
  @@index([gatewayOrderId])
  @@map("payment_attempts")
}

model PaymentAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  paymentAttemptId String   @map("payment_attempt_id") @db.Uuid
  billId           String   @map("bill_id") @db.Uuid
  allocatedPaise   Int      @map("allocated_paise")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  bill           Bill           @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([paymentAttemptId, billId])
  @@index([tenantId, billId])
  @@map("payment_allocations")
}

model Refund {
  id                      String       @id @default(uuid()) @db.Uuid
  tenantId                String       @map("tenant_id") @db.Uuid
  paymentAttemptId        String       @map("payment_attempt_id") @db.Uuid
  billId                  String       @map("bill_id") @db.Uuid
  amountPaise             Int          @map("amount_paise")
  reason                  String       @db.VarChar(200)
  status                  RefundStatus @default(PENDING)
  gatewayRefundId         String?      @unique @map("gateway_refund_id") @db.VarChar(100)
  initiatedByMembershipId String?      @map("initiated_by_membership_id") @db.Uuid
  processedAt             DateTime?    @map("processed_at") @db.Timestamptz()
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentAttempt        PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  bill                  Bill           @relation(fields: [billId], references: [id], onDelete: Restrict)
  initiatedByMembership Membership?    @relation("RefundInitiatedBy", fields: [initiatedByMembershipId], references: [id], onDelete: SetNull)

  @@index([tenantId, billId, createdAt])
  @@map("refunds")
}

model WebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String?       @map("tenant_id") @db.Uuid
  provider        String        @db.VarChar(30)
  providerEventId String        @map("provider_event_id") @db.VarChar(120)
