}

model SessionGuest {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  sessionId              String          @map("session_id") @db.Uuid
  guestTokenHash         String          @unique @map("guest_token_hash") @db.VarChar(128)
  displayLabel           String?         @map("display_label") @db.VarChar(40)
  status                 GuestJoinStatus @default(PENDING_APPROVAL)
  approvedByMembershipId String?         @map("approved_by_membership_id") @db.Uuid
  joinedAt               DateTime        @default(now()) @map("joined_at") @db.Timestamptz()
  approvedAt             DateTime?       @map("approved_at") @db.Timestamptz()
  lastSeenAt             DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz()

  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session              DiningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  approvedByMembership Membership?   @relation("GuestApprovedBy", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  orders               Order[]

  @@index([tenantId, sessionId, status])
  @@map("session_guests")
}

model Order {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  outletId             String        @map("outlet_id") @db.Uuid
  sessionId            String        @map("session_id") @db.Uuid
  guestId              String?       @map("guest_id") @db.Uuid
  placedByMembershipId String?       @map("placed_by_membership_id") @db.Uuid
  roundNumber          Int           @default(1) @map("round_number")
  kotNumber            Int           @map("kot_number")
  isAddOn              Boolean       @default(false) @map("is_add_on")
  source               OrderSource
  kitchenStatus        KitchenStatus @default(NEW) @map("kitchen_status")
  idempotencyKey       String        @map("idempotency_key") @db.VarChar(120)
  subtotalPaise              Int           @map("subtotal_paise")
  notes                      String?       @db.VarChar(250)
  acknowledgedAt             DateTime?     @map("acknowledged_at") @db.Timestamptz()
  acknowledgedByMembershipId String?       @map("acknowledged_by_membership_id") @db.Uuid
  acceptedAt                 DateTime?     @map("accepted_at") @db.Timestamptz()
  readyAt                    DateTime?     @map("ready_at") @db.Timestamptz()
  servedAt                   DateTime?     @map("served_at") @db.Timestamptz()
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant                   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet                   Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  session                  DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  guest                    SessionGuest? @relation(fields: [guestId], references: [id], onDelete: SetNull)
  placedByMembership       Membership?   @relation("OrderPlacedBy", fields: [placedByMembershipId], references: [id], onDelete: SetNull)
  acknowledgedByMembership Membership?   @relation("OrderAcknowledgedBy", fields: [acknowledgedByMembershipId], references: [id], onDelete: SetNull)
  items                    OrderItem[]
  events                   OrderEvent[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, outletId, sessionId, createdAt])
  @@index([tenantId, outletId, kitchenStatus, createdAt])
  @@index([tenantId, outletId, acknowledgedAt])
  @@index([tenantId, outletId, updatedAt])
  @@map("orders")
}

model OrderItem {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  orderId                String          @map("order_id") @db.Uuid
  menuItemId             String          @map("menu_item_id") @db.Uuid
