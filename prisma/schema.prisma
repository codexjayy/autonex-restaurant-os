// AutoNex Restaurant OS — Phase 1 + Phase 2 Prisma Schema
// Phase 1: tenants, outlets, users, memberships, refresh_tokens, audit_logs
// Phase 2: categories, menu_items, modifier_groups, modifier_options, restaurant_tables, table_qr_tokens
// Multi-tenant isolation: tenant_id on every tenant-owned table + PostgreSQL RLS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum TenantStatus {
  PENDING_APPROVAL
  TRIAL
  ACTIVE
  GRACE
  LOCKED
  SUSPENDED
  REJECTED
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DietaryType {
  VEG
  NON_VEG
  EGG
}

enum SelectionType {
  SINGLE
  MULTI
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BILL_REQUESTED
}

enum DiningSessionStatus {
  ACTIVE
  BILL_REQUESTED
  SETTLED
  CLOSED
}

enum GuestJoinStatus {
  PENDING_APPROVAL
  APPROVED
  REVOKED
}

enum OrderSource {
  CUSTOMER_QR
  STAFF_POS
}

enum KitchenStatus {
  NEW
  ACKNOWLEDGED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KitchenStation {
  MAIN_KITCHEN
  BAR
  BAKERY
  DESSERTS
}

enum OrderItemStatus {
  ACTIVE
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum TaxMode {
  EXCLUSIVE
  INCLUSIVE
  NONE
}

enum BillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum BillLineType {
  ITEM
  DISCOUNT
  CGST
  SGST
  ROUND_OFF
}

enum PaymentMethod {
  UPI_GATEWAY
  UPI_MANUAL
  CASH
  CARD
}

enum PaymentProvider {
  RAZORPAY
  MANUAL
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  SUSPENDED
}

enum SubscriptionBillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportCasePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportCaseCategory {
  ONBOARDING
  BILLING
  HARDWARE_QR
  TECHNICAL
  SUSPENSION_APPEAL
}

// ============================================================================
// PHASE 1 CORE TABLES
// ============================================================================

model Tenant {
  id                            String       @id @default(uuid()) @db.Uuid
  name                          String       @db.VarChar(120)
  slug                          String       @unique @db.VarChar(80)
  status                        TenantStatus @default(PENDING_APPROVAL)
  approvedAt                    DateTime?    @map("approved_at") @db.Timestamptz()
  approvedByUserId              String?      @map("approved_by_user_id") @db.Uuid
  rejectedAt                    DateTime?    @map("rejected_at") @db.Timestamptz()
  rejectedByUserId              String?      @map("rejected_by_user_id") @db.Uuid
  rejectionReason               String?      @map("rejection_reason") @db.VarChar(300)
  suspensionReason              String?      @map("suspension_reason") @db.VarChar(300)
  pendingSuspensionAfterService Boolean      @default(false) @map("pending_suspension_after_service")
  suspendedAt                   DateTime?    @map("suspended_at") @db.Timestamptz()
  offboardedAt                  DateTime?    @map("offboarded_at") @db.Timestamptz()
  deletedAt                     DateTime?    @map("deleted_at") @db.Timestamptz()
  createdAt                     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  approvedByUser       User?                 @relation("TenantApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedByUser       User?                 @relation("TenantRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  settings             TenantSettings?
  outletSettings       OutletSettings[]
  roles                Role[]
  invitations          Invitation[]
  sessions             Session[]
  outlets              Outlet[]
  memberships          Membership[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  categories           Category[]
  menuItems            MenuItem[]
  modifierGroups       ModifierGroup[]
  modifierOptions      ModifierOption[]
  restaurantTables     RestaurantTable[]
  tableQrTokens        TableQrToken[]
  diningSessions       DiningSession[]
  sessionGuests        SessionGuest[]
  orders               Order[]
  orderItems           OrderItem[]
  orderEvents          OrderEvent[]
  outboxEvents         OutboxEvent[]
  bills                Bill[]
  billLines            BillLine[]
  paymentAttempts      PaymentAttempt[]
  paymentAllocations   PaymentAllocation[]
  refunds              Refund[]
  webhookEvents        WebhookEvent[]
  subscription         Subscription?
  subscriptionInvoices SubscriptionInvoice[]
  supportCases         SupportCase[]
  supportCaseNotes     SupportCaseNote[]

  @@index([status, createdAt])
  @@map("tenants")
}

model Outlet {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  name                  String   @db.VarChar(120)
  contactPhone          String   @map("contact_phone") @db.VarChar(20)
  address               String?  @db.VarChar(300)
  logoUrl               String?  @map("logo_url")
  timezone              String   @default("Asia/Kolkata") @db.VarChar(60)
  gstin                 String?  @db.VarChar(20)
  gstRateBps            Int      @default(500) @map("gst_rate_bps")
  taxMode               TaxMode  @default(EXCLUSIVE) @map("tax_mode")
  roundOffEnabled       Boolean  @default(false) @map("round_off_enabled")
  requireWaiterApproval Boolean  @default(false) @map("require_waiter_approval")
  tablePinEnabled       Boolean  @default(false) @map("table_pin_enabled")
  invoiceSeq            Int      @default(0) @map("invoice_seq")
  kotSeq                Int      @default(0) @map("kot_seq")
  isActive              Boolean  @default(true) @map("is_active")
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings         OutletSettings?
  invitations      Invitation[]
  sessions         Session[]
  memberships      Membership[]
  categories       Category[]
  menuItems        MenuItem[]
  restaurantTables RestaurantTable[]
  tableQrTokens    TableQrToken[]
  diningSessions   DiningSession[]
  orders           Order[]
  bills            Bill[]
  paymentAttempts  PaymentAttempt[]
  supportCases     SupportCase[]

  @@index([tenantId, isActive])
  @@map("outlets")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String?   @unique @db.VarChar(160)
  phone               String    @unique @db.VarChar(20)
  name                String    @db.VarChar(100)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  isSuperAdmin        Boolean   @default(false) @map("is_super_admin")
  mfaEnabled          Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEnc        String?   @map("mfa_secret_enc") @db.VarChar(255)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz()
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz()
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz()
  isActive            Boolean   @default(true) @map("is_active")
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  memberships          Membership[]
  refreshTokens        RefreshToken[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]
  sentInvitations      Invitation[]      @relation("InvitationSentBy")
  approvedTenants      Tenant[]          @relation("TenantApprovedBy")
  rejectedTenants      Tenant[]          @relation("TenantRejectedBy")
  auditLogs            AuditLog[]
  createdSupportCases  SupportCase[]     @relation("SupportCreatedBy")
  assignedSupportCases SupportCase[]     @relation("SupportAssignedTo")
  supportCaseNotes     SupportCaseNote[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  usedAt    DateTime? @map("used_at") @db.Timestamptz()
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Membership {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  outletId       String    @map("outlet_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           StaffRole
  roleId         String?   @map("role_id") @db.Uuid
  staffPinHash   String    @map("staff_pin_hash") @db.VarChar(255)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz()
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet  Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleDef Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  openedSessions     DiningSession[] @relation("SessionOpenedBy")
  settledSessions    DiningSession[] @relation("SessionSettledBy")
  closedSessions     DiningSession[] @relation("SessionClosedBy")
  approvedGuests     SessionGuest[]  @relation("GuestApprovedBy")
  placedOrders       Order[]          @relation("OrderPlacedBy")
  acknowledgedOrders Order[]          @relation("OrderAcknowledgedBy")
  voidedBills        Bill[]           @relation("BillVoidedBy")
  confirmedPayments  PaymentAttempt[] @relation("PaymentConfirmedBy")
  initiatedRefunds   Refund[]         @relation("RefundInitiatedBy")

  @@unique([tenantId, outletId, userId])
  @@index([tenantId, outletId, role, isActive])
  @@map("memberships")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String?   @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorRole   String   @map("actor_role") @db.VarChar(20)
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actorUser User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ============================================================================
// MILESTONE 1 NORMALIZED FOUNDATION TABLES (SETTINGS, RBAC, INVITES, SESSIONS)
// ============================================================================

model TenantSettings {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  currency            String   @default("INR") @db.VarChar(10)
  locale              String   @default("en-IN") @db.VarChar(20)
  defaultTimezone     String   @default("Asia/Kolkata") @map("default_timezone") @db.VarChar(60)
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  onboardingStep      Int      @default(1) @map("onboarding_step")
  metadataJson        Json     @default("{}") @map("metadata_json")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model OutletSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  outletId              String   @unique @map("outlet_id") @db.Uuid
  taxMode               TaxMode  @default(EXCLUSIVE) @map("tax_mode")
  gstRateBps            Int      @default(500) @map("gst_rate_bps")
  roundOffEnabled       Boolean  @default(false) @map("round_off_enabled")
  requireWaiterApproval Boolean  @default(false) @map("require_waiter_approval")
  tablePinEnabled       Boolean  @default(false) @map("table_pin_enabled")
  kdsLanguage           String   @default("en") @map("kds_language") @db.VarChar(10)
  receiptFooter         String?  @map("receipt_footer") @db.VarChar(240)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([tenantId, outletId])
  @@map("outlet_settings")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(40)
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(240)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@index([isSystem, code])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  module      String   @db.VarChar(40)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  outletId        String           @map("outlet_id") @db.Uuid
  invitedByUserId String           @map("invited_by_user_id") @db.Uuid
  email           String?          @db.VarChar(160)
  phone           String           @db.VarChar(20)
  name            String           @db.VarChar(100)
  role            StaffRole
  tokenHash       String           @unique @map("token_hash") @db.VarChar(128)
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz()
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz()
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz()
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz()
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet        Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  invitedByUser User   @relation("InvitationSentBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, outletId, status])
  @@map("invitations")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  outletId     String?   @map("outlet_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @unique @map("family_id") @db.Uuid
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  userAgent    String?   @map("user_agent") @db.VarChar(300)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz()
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet Outlet? @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// PHASE 2: MENU MANAGEMENT & QR GENERATION TABLES
// ============================================================================

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  outletId  String   @map("outlet_id") @db.Uuid
  name      String   @db.VarChar(80)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@unique([tenantId, outletId, name])
  @@index([tenantId, outletId, isActive, sortOrder])
  @@map("categories")
}

model MenuItem {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  outletId       String      @map("outlet_id") @db.Uuid
  categoryId     String      @map("category_id") @db.Uuid
  name           String      @db.VarChar(120)
  description    String?     @db.VarChar(280)
  dietaryType    DietaryType @default(VEG) @map("dietary_type")
  basePricePaise  Int         @map("base_price_paise")
  prepTimeMinutes Int?          @map("prep_time_minutes")
  kitchenStation  KitchenStation @default(MAIN_KITCHEN) @map("kitchen_station")
  gstRateBps      Int?          @map("gst_rate_bps")
  taxMode         TaxMode?    @map("tax_mode")
  imageUrl        String?     @map("image_url")
  inStock        Boolean     @default(true) @map("in_stock")
  isActive       Boolean     @default(true) @map("is_active")
  sortOrder      Int         @default(0) @map("sort_order")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet         Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]

  @@index([tenantId, outletId, categoryId, isActive, inStock, sortOrder])
  @@map("menu_items")
}

model ModifierGroup {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  menuItemId    String        @map("menu_item_id") @db.Uuid
  name          String        @db.VarChar(60)
  selectionType SelectionType @default(SINGLE) @map("selection_type")
  isRequired    Boolean       @default(false) @map("is_required")
  minSelect     Int           @default(0) @map("min_select")
  maxSelect     Int           @default(1) @map("max_select")
  sortOrder     Int           @default(0) @map("sort_order")

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  ModifierOption[]

  @@index([tenantId, menuItemId, sortOrder])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  modifierGroupId String  @map("modifier_group_id") @db.Uuid
  name            String  @db.VarChar(60)
  priceDeltaPaise Int     @default(0) @map("price_delta_paise")
  inStock         Boolean @default(true) @map("in_stock")
  isDefault       Boolean @default(false) @map("is_default")
  sortOrder       Int     @default(0) @map("sort_order")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([tenantId, modifierGroupId, sortOrder])
  @@map("modifier_options")
}

model RestaurantTable {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  outletId     String      @map("outlet_id") @db.Uuid
  tableNumber  String      @map("table_number") @db.VarChar(20)
  label        String?     @db.VarChar(60)
  floorSection String?     @map("floor_section") @db.VarChar(60)
  capacity     Int         @default(4)
  status       TableStatus @default(AVAILABLE)
