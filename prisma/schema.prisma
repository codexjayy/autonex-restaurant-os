  resolutionNotes  String?             @map("resolution_notes") @db.VarChar(500)
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz()
  closedAt         DateTime?           @map("closed_at") @db.Timestamptz()
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outlet         Outlet?           @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdByUser  User              @relation("SupportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedToUser User?             @relation("SupportAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  notes          SupportCaseNote[]

  @@index([status, priority, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("support_cases")
}

model SupportCaseNote {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  supportCaseId String   @map("support_case_id") @db.Uuid
  authorUserId  String   @map("author_user_id") @db.Uuid
  authorRole    String   @map("author_role") @db.VarChar(20)
  body          String   @db.Text
  isInternal    Boolean  @default(false) @map("is_internal")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supportCase SupportCase @relation(fields: [supportCaseId], references: [id], onDelete: Cascade)
  authorUser  User        @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, supportCaseId, createdAt])
  @@map("support_case_notes")
}

model PlatformSettings {
  id                       String   @id @default("default") @db.VarChar(30)
  platformName             String   @default("AutoNex Restaurant OS") @map("platform_name") @db.VarChar(120)
  supportEmail             String   @default("support@autonex.in") @map("support_email") @db.VarChar(160)
  supportPhone             String   @default("+919999999999") @map("support_phone") @db.VarChar(20)
  defaultTrialDays         Int      @default(14) @map("default_trial_days")
  defaultGraceDays         Int      @default(3) @map("default_grace_days")
  saasGstRateBps           Int      @default(1800) @map("saas_gst_rate_bps")
  autoApproveRegistrations Boolean  @default(false) @map("auto_approve_registrations")
  maintenanceMode          Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage       String?  @map("maintenance_message") @db.VarChar(300)
  updatedByUserId          String?  @map("updated_by_user_id") @db.Uuid
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("platform_settings")
}
